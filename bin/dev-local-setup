#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

DUMMY_APP="spec/decidim_dummy_app"

echo "==> Starting Zitadel stack (first boot can take 1–2 minutes)..."
docker compose up -d zitadel-db mailcatcher zitadel user-fields-pg

ZITADEL_URL="${ZITADEL_URL:-http://localhost:8080}" ./bin/setup-zitadel-smtp
ZITADEL_URL="${ZITADEL_URL:-http://localhost:8080}" ./bin/setup-zitadel-oidc

if [[ ! -d "$DUMMY_APP" ]]; then
  echo "==> Generating dummy Decidim app (one-time)..."
  docker compose run --rm decidim bundle exec rake test_app
fi

echo "==> Patching dummy app secrets for openid_connect..."
docker compose run --rm decidim bash -c "
  cd ${DUMMY_APP} &&
  bundle exec rake decidim_custom_user_fields:dev:prepare_secrets
"

echo "==> Installing gems and preparing database..."
docker compose run --rm decidim bash -c "
  cd ${DUMMY_APP} &&
  bundle check || bundle install -j \$(nproc) &&
  bundle exec rails db:prepare &&
  bundle exec rails db:seed
"

echo "==> Seeding organization OIDC + scenario customizations..."
docker compose run --rm decidim bash -c "
  cd ${DUMMY_APP} &&
  bundle exec rake decidim_custom_user_fields:dev:seed
"

cat <<EOF

Local dev environment ready.

  Decidim:         http://localhost:3000
  Zitadel console: http://localhost:8080
  MailCatcher:     http://localhost:1080

  Zitadel admin:   admin@zitadel.localhost / Password1!
  Decidim admin:   admin@example.org / decidim123456789

Start the web server:

  docker compose --profile web up web

Or inside the decidim container:

  cd spec/decidim_dummy_app && bundle exec rails server -b 0.0.0.0

EOF
